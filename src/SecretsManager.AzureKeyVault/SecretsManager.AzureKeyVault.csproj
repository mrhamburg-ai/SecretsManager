<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageId>SecretsManager.AzureKeyVault</PackageId>
    <Description>Azure Key Vault secret provider for SecretsManager</Description>
    <Authors>mrhamburg</Authors>
    <License>MIT</License>
    <PackageTags>secrets;vault;secret-manager;azure;keyvault;dotnet</PackageTags>
    <RepositoryUrl>https://github.com/mrhamburg/SecretsManager</RepositoryUrl>
      <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\SecretsManager\SecretsManager.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Azure.Security.KeyVault.Secrets" />
    <PackageReference Include="Azure.Identity" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="SecretsManager.AzureKeyVault.Tests" />
    <InternalsVisibleTo Include="DynamicProxyGenAssembly2" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
