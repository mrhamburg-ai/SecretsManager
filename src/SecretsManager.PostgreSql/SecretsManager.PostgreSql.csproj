<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageId>SecretsManager.PostgreSql</PackageId>
    <Description>PostgreSQL secret provider with AES-256-GCM encryption at rest for SecretsManager</Description>
    <Authors>mrhamburg</Authors>
    <License>MIT</License>
    <PackageTags>secrets;vault;secret-manager;postgresql;dotnet</PackageTags>
    <RepositoryUrl>https://github.com/mrhamburg/SecretsManager</RepositoryUrl>
      <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\SecretsManager\SecretsManager.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Npgsql" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="SecretsManager.PostgreSql.Tests">
      <Key>$(SecretsManagerPublicKey)</Key>
    </InternalsVisibleTo>
    <InternalsVisibleTo Include="DynamicProxyGenAssembly2">
      <Key>$(DynamicProxyGenAssembly2PublicKey)</Key>
    </InternalsVisibleTo>
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
