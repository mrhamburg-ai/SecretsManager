<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageId>SecretsManager.Conjur</PackageId>
    <Description>CyberArk Conjur secret provider for SecretsManager</Description>
    <Authors>mrhamburg</Authors>
    <License>MIT</License>
    <PackageTags>secrets;vault;secret-manager;conjur;cyberark;dotnet</PackageTags>
    <RepositoryUrl>https://github.com/mrhamburg/SecretsManager</RepositoryUrl>
      <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\SecretsManager\SecretsManager.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="SecretsManager.Conjur.Tests">
      <Key>$(SecretsManagerPublicKey)</Key>
    </InternalsVisibleTo>
    <InternalsVisibleTo Include="DynamicProxyGenAssembly2">
      <Key>$(DynamicProxyGenAssembly2PublicKey)</Key>
    </InternalsVisibleTo>
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
