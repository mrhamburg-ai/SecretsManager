<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>

    <!--
      Fail the build on any compiler warning so warnings cannot accumulate again. This is what
      keeps CS1591 ("Missing XML comment for publicly visible type or member") from creeping
      back in: an undocumented public member now breaks the build instead of adding a line to a
      warning list nobody reads. The solution builds clean in both Debug and Release.
    -->
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>

    <!--
      Publish the repository URL in the package metadata and embed untracked sources in the
      PDB so Source Link can resolve every source file for package consumers.
    -->
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>

    <!--
      Release packages must be deterministic. Local Debug builds keep normal source paths for
      local debugging. The SDK includes Source Link for net8.0 and later, so no extra package
      reference is needed.
    -->
    <ContinuousIntegrationBuild Condition="'$(Configuration)' == 'Release'">true</ContinuousIntegrationBuild>
    <DeterministicSourcePaths Condition="'$(Configuration)' == 'Release'">true</DeterministicSourcePaths>
  </PropertyGroup>
</Project>
